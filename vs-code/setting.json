{ 
  "files.autoSave": "afterDelay",
  "workbench.colorTheme": "Tokyo Night Storm",
  "terminal.integrated.bellDuration": 10000,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "security.workspace.trust.untrustedFiles": "open",
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "window.customTitleBarVisibility": "windowed",
  "explorer.confirmPasteNative": false,
  // ---- Golang configs ----
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
  },
  "go.useLanguageServer": true,
  "go.toolsManagement.autoUpdate": true,
  "go.formatTool": "gofmt",
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "go.testOnSave": false,
  "go.vetOnSave": "workspace",
  "go.inlayHints.assignVariableTypes": false,
  "go.inlayHints.parameterNames": true,
  "go.inlayHints.constantValues": true,
  "go.inlayHints.rangeVariableTypes": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.stickyScroll.enabled": false,
  // ---- Zen Mode ----
  "zenMode.hideActivityBar": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": false,
  "files.trimTrailingWhitespace": true,
  // If running java, turn this on.
  "explorer.compactFolders": false,
  // ---- UI minimalism ----
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "none",
  "workbench.statusBar.visible": true,
  "workbench.sideBar.location": "right",
  "workbench.layoutControl.enabled": false,
  "workbench.tips.enabled": false,
  "window.commandCenter": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 8,
  "explorer.confirmDragAndDrop": false,
  "custom-ui-style.stylesheet": {
    ".notification-toast": "box-shadow: none !important",
    ".quick-input-widget.show-file-icons": "box-shadow: none !important",
    ".quick-input-widget": "top: 25vh !important",
    ".quick-input-list .scrollbar": "display: none",
    ".monaco-action-bar.quick-input-inline-action-bar": "display: none",
    ".editor-widget.find-widget": "box-shadow: none; border-radius: 4px"
  },
  "custom-ui-style.font.sansSerif": "JetBrains Mono, Fira Code, Roboto Mono, monospace",
  // ---- Clean visuals ----
  "editor.minimap.enabled": false,
  // Bread Crumbs -> User -> Rafael -> <something> -> ...
  // Bread Crumbs, if you want it back... set it to true
  "breadcrumbs.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.renderLineHighlight": "none",
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": false,
  // ---- Typography ----
  "editor.fontFamily": "JetBrains Mono, Fira Code, Roboto Mono, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "terminal.integrated.fontSize": 12,
  "editor.lineHeight": 22,
  "editor.lineNumbers": "relative",
  // ---- Editing behavior ----
  "editor.wordWrap": "on",
  "editor.formatOnSave": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  // ---- MUI settings ----
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.hidesExplorerArrows": true,
  "material-icon-theme.activeIconPack": "react_redux",
  "material-icon-theme.folders.associations": {
    "cmd": "command",
    "internal": "private",
    "pkg": "command",
    "api": "api",
    "configs": "config",
    "config": "config",
    "scripts": "scripts",
    "deploy": "docker",
    "build": "tools",
    "test": "test",
    "tests": "test",
    "migrations": "database",
    "db": "database",
  },
  "material-icon-theme.files.associations": {
    "go.mod": "go-mod",
    "go.sum": "go-mod",
    "*.go": "go",
    "*.tmpl": "template",
    "*.sql": "database",
    "*.env": "tune",
    "*.yaml": "yaml",
    "*.yml": "yaml",
  },
  // ---- Vim Config ----
  "vim.vimrc.enable": true,
  "vim.easymotion": true,
  "vim.useCtrlKeys": true,
  "vim.vimrc.path": "/home/rafael/c:\\Users\\Usuário\\AppData\\Roaming\\Code\\User\\.vimrc",
  "vim.useSystemClipboard": true,
  "vim.scrolloff": 10,
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ],
    },
  ],
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-p>": false,
    "<C-c>": false,
    "<C-j>": false,
  },
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
  },
  "workbench.startupEditor": "none",
  "editor.cursorSurroundingLines": 10,
  "glassit.alpha": 255,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
}
